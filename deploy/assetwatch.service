[Unit]
Description=Continuous Asset Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=assetwatch
WorkingDirectory=/opt/assetwatch
Environment=PATH=/opt/assetwatch/.venv/bin:/home/assetwatch/go/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/assetwatch.env
ExecStart=/opt/assetwatch/.venv/bin/assetwatch --config /opt/assetwatch/config.yaml run
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
